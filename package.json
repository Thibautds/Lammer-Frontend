{
  "name": "@lammer/cube",
  "version": "0.1.0",
  "description": "Open a Lammer weather cube and render or sample it -- elevation-corrected temperature, wind, precipitation phase and more, client-side, for MapLibre and Leaflet.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./maplibre": {
      "types": "./dist/maplibre.d.ts",
      "import": "./dist/maplibre.js"
    },
    "./leaflet": {
      "types": "./dist/leaflet.d.ts",
      "import": "./dist/leaflet.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0",
    "maplibre-gl": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "jsdom": "^25.0.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.20.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Thibautds/lammer-frontend"
  },
  "keywords": [
    "weather",
    "maplibre",
    "leaflet",
    "downscaling",
    "forecast"
  ]
}
